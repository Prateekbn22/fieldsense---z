#include <zephyr/dt-bindings/pinctrl/esp32-pinctrl.h>

/ {
aliases {
fieldsense-i2c = &i2c0;
fieldsense-env-sensor = &fieldsense_bmp280;
};
};

&pinctrl {
fieldsense_i2c0_default: fieldsense_i2c0_default {
group1 {
pinmux = <I2C0_SDA_GPIO21>,
 <I2C0_SCL_GPIO22>;
bias-pull-up;
drive-open-drain;
output-high;
};
};
};

&i2c0 {
status = "okay";
clock-frequency = <100000>;
pinctrl-0 = <&fieldsense_i2c0_default>;
pinctrl-names = "default";

#address-cells = <1>;
#size-cells = <0>;

fieldsense_bmp280: bmp280@76 {
compatible = "bosch,bme280";
reg = <0x76>;
status = "okay";
};
};
